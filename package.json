{
  "name": "spillgate-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Workspace root of spillgate-js: spillgate, spillgate-br, spillgate-zstd.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run build && npm test --workspaces --if-present",
    "spectrace": "npm run spectrace -w spillgate"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^5.9"
  }
}

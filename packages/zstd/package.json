{
  "name": "spillgate-zstd",
  "version": "0.1.3",
  "description": "Zstandard for spillgate: an own decoder with window cap, dictionary refusal and exact input accounting.",
  "keywords": [
    "zstd",
    "zstandard",
    "spillgate",
    "decompression-bomb",
    "security"
  ],
  "license": "MIT",
  "author": "Felix Middelhoff",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FelixMiddelhoff/spillgate-js.git",
    "directory": "packages/zstd"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/tests/**/*.test.js\""
  },
  "dependencies": {},
  "peerDependencies": {
    "spillgate": "0.1.3"
  },
  "devDependencies": {
    "spillgate-test-support": "0.0.0"
  }
}
